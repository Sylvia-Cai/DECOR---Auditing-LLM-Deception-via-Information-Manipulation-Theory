# Copy this file to .env and fill in only the keys for the providers/models you plan to run.
# See config.py for the full LLM_PRESETS registry.

# ── Direct provider APIs (recommended if you don't have access to the authors' ──
# ── Azure deployment — these work with a plain, personal API key from each vendor) ──
OPENAI_API_KEY=your_openai_key                    # openai_gpt4o
ANTHROPIC_API_KEY=your_anthropic_key              # anthropic_claude_sonnet46
GOOGLE_API_KEY=your_google_key                    # google_gemini25pro / google_gemini31pro
OPENROUTER_API_KEY=your_openrouter_key            # openrouter_*
SILICONFLOW_API_KEY=your_siliconflow_key          # siliconflow_*

# ── Azure-hosted presets (azure_*) — require your own Azure OpenAI / Azure AI ──
# ── Foundry resource with matching deployment names; used to reproduce the ──
# ── authors' exact runs, not needed if you're using the direct presets above ──
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_FOUNDRY_API_KEY=your_azure_foundry_key      # falls back to AZURE_OPENAI_API_KEY if unset
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_ANTHROPIC_API_KEY=your_azure_anthropic_key
AZURE_ANTHROPIC_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/anthropic/

# Optional: override the default LLM preset used when --model is not passed (default: azure_gpt4o)
# DECEPTION_LLM_PRESET=openai_gpt4o
